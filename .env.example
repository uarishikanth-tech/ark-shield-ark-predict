# ============================================================
# ARK SHIELD server (Python) — environment variables
# Copy this file to `.env` and fill in real values.
# Never commit a real `.env` file to source control.
# ============================================================

# PostgreSQL connection string, asyncpg driver (used by SQLAlchemy's
# async engine). Format:
#   postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql+asyncpg://arkshield:arkshield@localhost:5432/arkshield"

# Alembic runs migrations synchronously; this is the same database,
# just with the plain "postgresql://" (psycopg2) driver instead of
# "+asyncpg". Keep the user/host/port/database identical to DATABASE_URL.
ALEMBIC_DATABASE_URL="postgresql://arkshield:arkshield@localhost:5432/arkshield"

# Secret used to sign/verify JWTs. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(48))"
# Never reuse this demo placeholder outside local development.
JWT_SECRET="replace-with-a-long-random-secret-before-running-anywhere-but-localhost"
JWT_ALGORITHM="HS256"

# How long issued JWTs remain valid, in hours.
JWT_EXPIRES_HOURS=12

# Port the API server listens on.
PORT=4000

# Origin the frontend is served from, for CORS + Socket.IO.
WEB_ORIGIN="http://localhost:3000"

# Base URL of this API, as consumed by a frontend.
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_URL="http://localhost:4000"

# If "true", the simulation engine starts automatically on boot.
# Simulated records are always written with is_simulated = true and are
# never to be confused with real sensor data.
AUTO_START_SIMULATION="true"

# Seconds between simulation ticks.
SIMULATION_TICK_SECONDS=2.0

# ------------------------------------------------------------
# ARK Predict — streaming machine-health anomaly detection
# (in-memory, needs no database; see ANOMALY.md)
# ------------------------------------------------------------
ANOMALY_AUTO_START="true"
# "true" = /api/anomaly/* open without a JWT (the demo UI has no real token).
# Set "false" for any shared deployment.
ANOMALY_PUBLIC_DEMO="true"
# Simulated seconds per 0.5 s tick (2 = 4x real time).
ANOMALY_SPEED=2
# Random labelled faults injected per simulated minute across the fleet.
ANOMALY_FAULT_RATE_PER_MIN=0.8
ANOMALY_SEED=7
